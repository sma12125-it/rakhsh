{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakhsh.example/schemas/vehicle-pack/manifest.schema.json",
  "title": "Rakhsh Vehicle Pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "vehicle",
    "compatibility",
    "assets",
    "checksum",
    "publication",
    "dataSources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*$",
      "description": "Stable id, e.g. peugeot.207.sedan"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "make",
        "model",
        "generation"
      ],
      "properties": {
        "make": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string"
        },
        "modelYears": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from"
          ],
          "properties": {
            "from": {
              "type": "integer",
              "minimum": 1900
            },
            "to": {
              "type": "integer",
              "minimum": 1900
            }
          }
        },
        "names": {
          "type": "object",
          "description": "Localised display names",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minAppVersion"
      ],
      "properties": {
        "minAppVersion": {
          "type": "string"
        },
        "maxAppVersion": {
          "type": "string"
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mime",
          "bytes",
          "sha256",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^assets/[^.][^\\\\]*$"
          },
          "mime": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "enum": [
              "front",
              "rear",
              "side",
              "closeup",
              "top",
              "interior",
              "color-variant",
              "thumbnail",
              "model3d",
              "component-map"
            ]
          },
          "colorId": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publishedAt",
        "publisher",
        "status"
      ],
      "properties": {
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "publisher": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "deprecated",
            "withdrawn"
          ]
        },
        "supersedes": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "dataSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "verified",
              "thirdParty"
            ]
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
